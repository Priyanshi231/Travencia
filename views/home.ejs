<% layout("layouts/boilerplate") %>

<!-- HERO SECTION -->

<section class="hero-section">

    <div class="hero-content">

        <h1>StaySphere</h1>

        <h2>
            Discover Extraordinary Places To Stay
        </h2>

        <p>
            Luxury villas, cozy cabins, beachfront escapes,
            and unique accommodations for unforgettable experiences.
        </p>

        <div class="hero-buttons">
            <a href="/listings" class="btn btn-dark btn-lg">
                Explore Stays
            </a>

            <a href="/listings/new" class="btn btn-outline-light btn-lg">
                Become a Host
            </a>
        </div>

    </div>

</section>

<!-- CATEGORIES -->

<section class="container my-5">

    <div class="text-center mb-5">

        <h2 class="section-title">
            Explore Extraordinary Stays
        </h2>

        <p class="section-subtitle">
            Find the perfect stay tailored to your travel style.
        </p>

    </div>

    <div class="row g-4">

        <div class="col-md-4">

            <div class="category-card">
                 <a href="/listings">
                <img
                    src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e"
                    alt="Beachfront"
                >
                </a>

                <div class="category-content">
                    <h4>Beachfront Escapes</h4>
                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="category-card">
                    <a href="/listings">
                <img
                    src="https://images.unsplash.com/photo-1506744038136-46273834b3fb"
                    alt="Mountain"
                >
                    </a>
                <div class="category-content">
                    <h4>Mountain Retreats</h4>
                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="category-card">
                <a href="/listings">

                <img
                    src="https://images.unsplash.com/photo-1566073771259-6a8506099945"
                    alt="Luxury"
                >
`                </a>
                <div class="category-content">
                    <h4>Luxury Villas</h4>
                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="category-card">
                <a href="/listings">
                <img
                    src="https://images.unsplash.com/photo-1449824913935-59a10b8d2000"
                    alt="City"
                >
                </a>

                <div class="category-content">
                    <h4>Urban Apartments</h4>
                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="category-card">
                <a href="/listings">
                <img
                    src="https://images.unsplash.com/photo-1448375240586-882707db888b"
                    alt="Cabin"
                >
                </a>

                <div class="category-content">
                    <h4>Nature Cabins</h4>
                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="category-card">
                <a href="/listings">

                <img
                    src="https://images.unsplash.com/photo-1505693416388-ac5ce068fe85"
                    alt="Premium"
                >
                </a>
                <div class="category-content">
                    <h4>Premium Stays</h4>
                </div>

            </div>

        </div>

    </div>

</section>

<!-- STATS -->

<section class="stats-section">

    <div class="container">

        <div class="row text-center">

            <div class="col-md-3 col-6">
                <div class="stat-card">
                    <h2>10K+</h2>
                    <p>Happy Guests</p>
                </div>
            </div>

            <div class="col-md-3 col-6">
                <div class="stat-card">
                    <h2>2K+</h2>
                    <p>Verified Stays</p>
                </div>
            </div>

            <div class="col-md-3 col-6">
                <div class="stat-card">
                    <h2>50+</h2>
                    <p>Countries</p>
                </div>
            </div>

            <div class="col-md-3 col-6">
                <div class="stat-card">
                    <h2>4.9★</h2>
                    <p>Guest Rating</p>
                </div>
            </div>

        </div>

    </div>

</section>

<!-- WHY US -->

<section class="why-section">

    <div class="container">

        <div class="text-center mb-5">

            <span class="section-tag">
                TRUSTED WORLDWIDE
            </span>

            <h2 class="why-title">
                Why Travelers Choose StaySphere
            </h2>

            <p class="why-subtitle">
                Experience seamless booking, premium properties,
                and unforgettable stays.
            </p>

        </div>

        <div class="row g-4">

            <div class="col-lg-4">

                <div class="feature-card">

                    <div class="icon-circle">
                        <i class="fa-solid fa-shield-halved"></i>
                    </div>

                    <h4>Verified Properties</h4>

                    <p>
                        Every stay is reviewed and verified
                        for quality and trust.
                    </p>

                </div>

            </div>

            <div class="col-lg-4">

                <div class="feature-card">

                    <div class="icon-circle">
                        <i class="fa-solid fa-lock"></i>
                    </div>

                    <h4>Secure Booking</h4>

                    <p>
                        Safe payments and a seamless
                        reservation experience.
                    </p>

                </div>

            </div>

            <div class="col-lg-4">

                <div class="feature-card">

                    <div class="icon-circle">
                        <i class="fa-solid fa-star"></i>
                    </div>

                    <h4>Premium Experiences</h4>

                    <p>
                        Discover unique accommodations
                        designed to create memories.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>

<!-- CTA -->

<section class="cta-section">

    <div class="container text-center">

        <h2>
            Your Perfect Escape Awaits
        </h2>

        <p>
            Discover unique stays around the world and
            create unforgettable travel experiences.
        </p>

        <a href="/listings" class="btn btn-light btn-lg">
            Browse Listings
        </a>

    </div>

</section>