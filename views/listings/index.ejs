<% layout("/layouts/boilerplate") %>

    <div id="filters">
        <div class="filter">
            <div><i class="fa-solid fa-fire"></i></div>
            <p>Trending</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-bed"></i></div>
            <p>Rooms</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-city"></i></div>
            <p>Iconic Cities</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-mountain"></i></div>
            <p>Mountains</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-fort-awesome"></i></div>
            <p>Castles</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-swimmer"></i></div>
            <p>Amazing Pools</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-tent"></i></div>
            <p>Camping</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-tractor"></i></div>
            <p>Farms</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-snowflake"></i></div>
            <p>Arctic</p>
        </div>

    </div>
    <br>

    <% if(allListings.length===0){ %>

        <div class="text-center mt-5">

            <h3>No stays found</h3>

            <p>
                Try searching for another destination.
            </p>

        </div>

        <% } %>

 <div class="row g-4">

    <% for(let listing of allListings) { %>

    <div class="col-lg-4 col-md-6 col-12">

        <a href="/listings/<%= listing._id %>" class="listing-link">

            <div class="category-card listing-card">

                <img
                    src="<%= listing.image.url %>"
                    class="card-img-top"
                    alt="listing image"
                >

                <div class="card-body">

                    <p class="category-content">

                        <b><%= listing.title %></b>

                        <br>

                        &#8377;
                        <%= listing.price.toLocaleString("en-IN") %>
                        per night

                    </p>

                </div>

            </div>

        </a>

    </div>

    <% } %>

</div>